<?xml version="1.0" encoding="utf-8"?>
<!--
  Ultra Verdello Street Fight 7 — app Android nativa.

  Scelte di base:
  - niente AndroidX né Gradle: si compila con gli strumenti dell'SDK (aapt2,
    javac, d8, apksigner), quindi zero dipendenze da scaricare;
  - l'app è un contenitore nativo (WebView) del gioco: essendo il gioco caricato
    dall'indirizzo remoto, ogni push sul repository aggiorna il gioco senza
    reinstallare l'APK;
  - l'APK invece si aggiorna da solo leggendo le Release su GitHub.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="it.uvsf7.app"
    android:versionCode="2"
    android:versionName="1.0.1">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- serve per installare l'aggiornamento scaricato dalle Release -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <uses-sdk android:minSdkVersion="24" android:targetSdkVersion="35" />

    <application
        android:allowBackup="false"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.NoTitleBar.Fullscreen"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|smallestScreenSize"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="sensorLandscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Espone l'APK scaricato come content:// così il sistema può installarlo
             senza FileUriExposedException (dalla API 24 i file:// non passano più). -->
        <provider
            android:name=".ApkProvider"
            android:authorities="it.uvsf7.app.apk"
            android:exported="false"
            android:grantUriPermissions="true" />

    </application>
</manifest>
